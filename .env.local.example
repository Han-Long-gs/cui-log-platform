# For running on the Mac without compose (uvicorn / celery / pytest / scripts).
# Copy once per environment and replace every <placeholder>:
#   cp .env.local.example .env.dev     # uv run --env-file .env.dev ...
#   cp .env.local.example .env.test    # uv run --env-file .env.test pytest
#   cp .env.local.example .env.bench   # benchmark scripts
# These are read by cui_config.Settings (packages/config), not by docker compose.
# Use letters and digits only in passwords: @ / : would break the URLs.

# Postgres on the host (Homebrew, port 5432). Use a different database per file: cui_dev / cui_test / cui_bench
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/cui_dev

# RabbitMQ on the host
BROKER_URL=amqp://<user>:<password>@127.0.0.1:5672//

# queue | sync. sync is rejected unless ALLOW_INGEST_SYNC=true (sync is the Phase 2 baseline, kept for experiment 1)
INGEST_MODE=queue
ALLOW_INGEST_SYNC=false

# macOS only: works around Celery's prefork child processes on macOS. Not needed on Linux
FORKED_BY_MULTIPROCESSING=1
