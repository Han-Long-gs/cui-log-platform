# Local Postgres (Ticket 1.1). Copy to make three files: .env.test, .env.dev, .env.prod, .env.bench and fill in your real password.
DATABASE_URL=postgresql+asyncpg://han:<password>@localhost:5432/cui_test
BROKER_URL=amqp://guest:<password>@127.0.0.1:5672//
# queue | sync, if ALLOW_INGEST_SYNC is false then cannot be sync
INGEST_MODE=queue
ALLOW_INGEST_SYNC=false