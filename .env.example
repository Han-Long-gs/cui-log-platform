# For docker compose. Copy to `.env` (project root) and replace every <placeholder>.
#   cp .env.example .env
# Compose reads `.env` only to fill in the ${...} in docker-compose.yml; the containers get
# DATABASE_URL / BROKER_URL built from these values (see `environment:` there), so don't add them here.
# Running uvicorn / celery / pytest directly on the Mac uses a different file: see .env.local.example.
#
# Use letters and digits only: these values are pasted into connection URLs, and @ / : would break them.
# Postgres and RabbitMQ only read these on first start (empty volume). Changing them later
# does nothing until the volume is recreated or the password is changed inside the server.

# Postgres container: creates this user / password / database on first start
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=cui

# RabbitMQ container: creates this user on first start
RABBITMQ_DEFAULT_USER=<user>
RABBITMQ_DEFAULT_PASS=<password>
